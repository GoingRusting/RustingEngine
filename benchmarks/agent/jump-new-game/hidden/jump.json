    {"tick": 165, "expect": {"counter": "jumps", "equals": 1}},
    {"tick": 170, "tap": "jump"},
    {"tick": 172, "expect": {"counter": "jumps", "equals": 1}},
    {"tick": 250, "expect": {"entity": "Ball", "path": "/transform/position/1", "equals": 0.5, "tolerance": 0.05}},
    {"tick": 250, "expect": {"counter": "jumps", "equals": 1}}
  ]
