{
  "name": "plant: one numbered seed a second at x = 2n, five at most",
  "ticks": 420,
  "steps": [
    {"tick": 30, "expect": {"counter": "planted", "equals": 0}},
    {"tick": 30, "expect": {"entity": "Seed 1", "exists": false}},
    {"tick": 60, "within": 62, "expect": {"entity": "Seed 1", "exists": true}},
    {"tick": 70, "expect": {"entity": "Seed 1", "path": "/transform/position/0", "equals": 2.0, "tolerance": 0.01}},
    {"tick": 70, "expect": {"entity": "Seed 1", "path": "/transform/position/1", "equals": 0.5, "tolerance": 0.01}},
    {"tick": 70, "expect": {"entity": "Seed 2", "exists": false}},
    {"tick": 70, "expect": {"entity": "Seed", "path": "/transform/position/1", "equals": -5.0, "tolerance": 0.01}},
    {"tick": 190, "expect": {"counter": "planted", "equals": 3}},
    {"tick": 190, "expect": {"entity": "Seed 3", "path": "/transform/position/0", "equals": 6.0, "tolerance": 0.01}},
    {"tick": 410, "expect": {"counter": "planted", "equals": 5}},
    {"tick": 410, "expect": {"entity": "Seed 5", "path": "/transform/position/0", "equals": 10.0, "tolerance": 0.01}},
    {"tick": 410, "expect": {"entity": "Seed 6", "exists": false}}
  ]
}
